# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Max webhook payload size, bytes (default 1 MiB).
# Raise this for mail with attachments — base64 inflates the MIME by ~33%,
# so a 25 MB attachment limit needs roughly 35000000 here.
BODY_LIMIT=1048576

# Shared secret expected in the `x-webhook-secret` header.
# Leave unset to accept unauthenticated webhooks (local dev only).
WEBHOOK_SECRET=

# Dot path to the raw MIME message inside the JSON payload, e.g. message.raw
# Unset = probe common field names (rawMime, raw, content, message, ...).
MAIL_FIELD=

# auto (sniff base64 vs plain MIME) | base64 | utf8
MAIL_ENCODING=auto
