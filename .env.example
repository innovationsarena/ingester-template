# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Max webhook payload size, bytes (default 30 MB).
# Base64 inflates MIME by ~33%, so a 25 MB attachment arrives as ~34 MB of body.
BODY_LIMIT=31457280

# Shared secret expected in the `x-webhook-secret` header.
# Leave unset to accept unauthenticated webhooks (local dev only).
WEBHOOK_SECRET=

# --- Mail extraction -------------------------------------------------------
# Dot path to the raw MIME message inside the JSON payload, e.g. message.raw
# Unset = probe common field names (rawMime, raw, content, message, ...).
MAIL_FIELD=

# auto (sniff base64 vs plain MIME) | base64 | utf8
MAIL_ENCODING=auto

# --- Docling ---------------------------------------------------------------
# docling-serve base URL. Unset = attachments are not converted.
# From inside Docker use host.docker.internal or a shared network, not localhost.
DOCLING_URL=http://localhost:5001

# Required only when docling-serve runs with DOCLING_SERVE_API_KEY set.
DOCLING_API_KEY=

# Per-document timeout; OCR on a large scan is slow.
DOCLING_TIMEOUT_MS=120000

# How many documents to convert at once.
DOCLING_CONCURRENCY=2

# Attachments larger than this are skipped rather than converted (25 MB).
MAX_ATTACHMENT_BYTES=26214400

# --- MCP -------------------------------------------------------------------
# Streamable-HTTP MCP endpoint whose tools every agent gets.
# Empty (MCP_URL=) runs the agents with no MCP tools.
MCP_URL=https://gr-mcp.innovationsarenan.se/mcp

# Per-request timeout for MCP calls, tool listing included.
MCP_TIMEOUT_MS=30000

# --- Agent -----------------------------------------------------------------
# Unset = the pipeline still converts, and logs that the agent was skipped.
ANTHROPIC_API_KEY=

AGENT_MODEL=claude-opus-5

# System prompt for the fallback agent. Per-hook agents live in src/agents/index.ts.
AGENT_INSTRUCTIONS=

# How long shutdown waits for in-flight pipelines before exiting.
JOB_DRAIN_TIMEOUT_MS=30000
