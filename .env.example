OPENAI_API_KEY=

# MCP server the ingest agent gets its tools from (Streamable HTTP or SSE).
# Leave unset to run without MCP tools.
MCP_SERVER_URL=
# Optional bearer token sent to the MCP server.
MCP_SERVER_TOKEN=

# Optional shared secret for POST /webhooks/ingest. When set, requests must send a
# matching X-Webhook-Secret header. When unset, the route is fully open.
WEBHOOK_SECRET=
